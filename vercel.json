{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/payments/create-order",
      "destination": "/api/payments-create-order"
    },
    {
      "source": "/api/payments/confirm-order",
      "destination": "/api/payments-confirm-order"
    },
    {
      "source": "/api/payments/wechat/notify",
      "destination": "/api/payments-wechat-notify"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/generate.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/payments/reconcile.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/payments/reconcile",
      "schedule": "0 3 * * *"
    }
  ]
}
