# =========================================================
# EchoMap local env template
# 复制本文件为 .env 后填写真实值（不要提交真实 key）
# =========================================================

# --- AI Provider keys ---
# Gemini API key（走 Google API Key 模式时需要）
GEMINI_API_KEY=

# OpenAI key（激活侧边栏 ChatGPT 图像 2.0 出图时需要）
OPENAI_API_KEY=
# OpenAI 兼容网关地址（官方可留空；APIMart 可填 https://api.apimart.ai/v1）
OPENAI_BASE_URL=
# OpenAI image model（可选；默认 chatgpt-image-latest）
OPENAI_IMAGE_MODEL=chatgpt-image-latest
# OpenAI 图片默认走更省钱的固定档：1024x1024 + medium
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
# APIMart gpt-image-2 这类异步图片接口默认分辨率档位
OPENAI_IMAGE_RESOLUTION=1k

# 即梦 4.6（官方智能视觉异步接口）
JIMENG_ACCESS_KEY_ID=
JIMENG_SECRET_ACCESS_KEY=
JIMENG_BASE_URL=https://visual.volcengineapi.com
JIMENG_REQ_KEY=jimeng_seedream46_cvtob
JIMENG_REGION=cn-north-1
JIMENG_SERVICE=cv
# 默认面积 4194304 = 2048*2048
JIMENG_SIZE=4194304
# 文本影响程度，支持 0~1 或 1~100；请求即梦时会统一转成 1~100 的整数
JIMENG_SCALE=0.65

# --- Vertex AI（走 Google Cloud Vertex 模式时需要）---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# 二选一：
# 1) 本地有 json 文件时填路径
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-service-account.json
#
# 2) 部署/无文件系统时填完整 JSON（单行）
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Image model overrides（可选）---
# 默认 gemini 模型（未填时代码会用默认值）
GEMINI_IMAGE_MODEL=
# 兼容旧变量名（可留空）
ECHO_IMAGE_MODEL=
# 兼容旧 key 变量（可留空）
API_KEY=

# --- CORS（仅后端独立部署时常用，可选）---
# 例如 https://xxx.vercel.app
ALLOW_ORIGIN=

# --- Frontend -> external API base（生产分离部署时填）---
# 把 vite-plugin-echo-api 等价部署为独立服务后填写（无尾斜杠）；本地通常留空
VITE_API_BASE_URL=

# --- Mainland-friendly frontend runtime config（大陆版推荐）---
# global | cn
VITE_APP_VARIANT=global
# 高德 Web Service Key（切到 cn 模式时建议填写）
VITE_AMAP_WEB_KEY=
# 高德 JS API Key（若切换为高德 JS SDK 底图，建议填写；未填时默认回退复用 Web Key）
VITE_AMAP_JS_KEY=
# 高德地图样式。留空时使用高德默认底图风格；若你有自定义样式 ID，也可填成 amap://styles/你的样式ID
VITE_AMAP_MAP_STYLE=
# Mapbox 视觉底图 token（推荐搭配 cn 版使用，搜索/逆地理仍可保留高德）
VITE_MAPBOX_ACCESS_TOKEN=
# Mapbox 视觉底图样式（默认 standard；代码里会进一步压成无字、无道路的 editorial 风格）
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/standard
# 地图瓦片服务（示例仍保留当前默认值，切国内地图服务时改这里）
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_MAP_TILE_ATTRIBUTION=Map data providers
VITE_MAP_TILE_SUBDOMAINS=abcd
# 搜索建议接口模板：支持 {query} {lang} {limit}
VITE_PLACE_SEARCH_TEMPLATE=https://nominatim.openstreetmap.org/search?format=jsonv2&q={query}&accept-language={lang}&limit={limit}
# 逆地理编码接口模板：支持 {lat} {lng} {lang} {zoom}
VITE_REVERSE_GEOCODE_TEMPLATE=https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat={lat}&lon={lng}&accept-language={lang}&zoom={zoom}
# IP 定位接口
VITE_IP_GEO_URL=https://ipapi.co/json/

# --- Supabase（云端登录与建筑同步）---
# 在 https://supabase.com 新建项目 -> Project Settings -> API
# URL 只填项目根域名，例如 https://xxxx.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# 旧版兼容回退；迁移完成后可移除
VITE_SUPABASE_ANON_KEY=
# 服务端也会用 Supabase 验证 Authorization Bearer token
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# 旧版兼容回退；迁移完成后可移除
SUPABASE_ANON_KEY=
# 仅当 ECHO_ENTITLEMENTS_STORE=supabase 时需要；优先使用 Secret API key，只放服务端
SUPABASE_SECRET_KEY=
# 兼容旧项目；不要使用 anon key 作为配额写入密钥
SUPABASE_SERVICE_ROLE_KEY=

# --- Free 版本额度拦截（服务端 /api/generate 生效）---
# 默认开启；本地临时调试可设为 false
ECHO_GENERATION_QUOTA_ENABLED=true
# file = 单机文件型（默认）；supabase = Supabase 表持久化（多实例/正式生产推荐）
ECHO_ENTITLEMENTS_STORE=file
# file store 默认写到 logs/entitlements.json；如需持久目录可改成绝对路径
ECHO_ENTITLEMENTS_STORE_PATH=
# supabase store 默认表名 echo_entitlements
ECHO_ENTITLEMENTS_TABLE=echo_entitlements
# 与当前版本方案文案一致：新用户 8 次，之后每月 2 次
ECHO_FREE_STARTER_GENERATIONS=8
ECHO_FREE_MONTHLY_GENERATIONS=2
ECHO_PLUS_MONTHLY_GENERATIONS=20
ECHO_PRO_MONTHLY_GENERATIONS=60
ECHO_INITIAL_EXTRA_CREDITS=0

# --- 支付订单 ---
ECHO_PAYMENT_ORDERS_PATH=
# file = 单进程验证；supabase = payment_orders + credit_ledger 数据库事务
ECHO_PAYMENT_ORDERS_STORE=file
# manual = 外部链接/人工确认；wechat_native = 微信 Native；alipay_page = 支付宝电脑网站支付 POST 表单
ECHO_PAYMENT_PROVIDER=manual
ECHO_PLUS_PAYMENT_URL=
ECHO_PRO_PAYMENT_URL=
ECHO_PLUS_PAYMENT_AMOUNT_CNY=5
ECHO_PRO_PAYMENT_AMOUNT_CNY=12.9
ECHO_PLUS_PAYMENT_CREDITS=20
ECHO_PRO_PAYMENT_CREDITS=60
ECHO_PLUS_PAYMENT_INSTRUCTIONS=测试期支付后人工确认开通额度。请保留订单号，付款后联系产品方。
ECHO_PRO_PAYMENT_INSTRUCTIONS=测试期支付后人工确认开通额度。请保留订单号，付款后联系产品方。
# manual 支付人工确认接口的服务端密钥；不要暴露给浏览器
ECHO_PAYMENT_ADMIN_KEY=
CRON_SECRET=

# --- 微信支付商户 Native 自动开通（ECHO_PAYMENT_PROVIDER=wechat_native 时必填）---
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
# 二选一：建议服务器上使用 *_PATH，不要把私钥直接写进仓库
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://echomap.syan12.cn/api/payments/wechat/notify
# API v3 密钥，32 字节；用于解密支付通知
WECHAT_PAY_API_V3_KEY=
# 微信支付平台公钥/证书序列号，用于验签通知；二选一填写 PUBLIC_KEY 或 PUBLIC_KEY_PATH
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=

# --- 支付宝网页收款（ECHO_PAYMENT_PROVIDER=alipay_page）---
# 开发沙箱用 sandbox；正式收款需先完成支付宝产品签约并配置 production 凭据。
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_SELLER_EMAIL=
ALIPAY_GATEWAY=
ALIPAY_RETURN_URL=https://echomap.syan12.cn/payment/return
ALIPAY_NOTIFY_URL=https://echomap.syan12.cn/api/payments/alipay/notify

# --- 云端保存容量配额（服务端 /api/usage-quota 生效）---
# storage bytes 默认按 photo limit * 单张上传上限估算；生产建议按对象存储预算显式配置
ECHO_USAGE_QUOTA_ENABLED=true
ECHO_FREE_LANDMARK_LIMIT=20
ECHO_FREE_PHOTO_LIMIT=500
ECHO_FREE_STORAGE_BYTES=
ECHO_PLUS_LANDMARK_LIMIT=100
ECHO_PLUS_PHOTO_LIMIT=1000
ECHO_PLUS_STORAGE_BYTES=
ECHO_PRO_LANDMARK_LIMIT=500
ECHO_PRO_PHOTO_LIMIT=3000
ECHO_PRO_STORAGE_BYTES=
